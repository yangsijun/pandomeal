<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  판교도서관 식단 크롤러. 시스템 LaunchDaemon, pandomeal 계정으로 실행 → 아무도 로그인하지 않아도 매일 09:00(중식)·13:30(석식) 에 돈다.
  13:30 은 pandomeal.py 의 DINNER_FROM 과 같아야 한다.
  그 시각에 잠자기 중이었으면 깨어난 직후 한 번 실행된다. 등록 직후에도 한 번 돈다(RunAtLoad).
  설치·갱신: sudo scripts/install-service.sh
  uv 는 root 소유 /usr/local/bin/uv 를 쓴다: 개인 계정의 Homebrew 업그레이드에 영향받지 않게.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>xyz.tntlab.pandomeal</string>
  <key>UserName</key>
  <string>pandomeal</string>
  <key>GroupName</key>
  <string>staff</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <string>/Users/pandomeal/app</string>
    <string>python</string>
    <string>/Users/pandomeal/app/pandomeal.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/pandomeal/app</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/pandomeal</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>ko_KR.UTF-8</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>13</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/pandomeal/app/logs/crawler.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pandomeal/app/logs/crawler.log</string>
</dict>
</plist>
